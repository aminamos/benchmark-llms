"""Helper to verify tearDown calls with --pdb"""
import subprocess, textwrap, pathlib, sys, os, tempfile

def run_case(name, code, expect_pass=True):
    with tempfile.TemporaryDirectory() as td:
        p = pathlib.Path(td) / "test_case.py"
        p.write_text(code)
        # use --pdb but feed 'c' (continue) if pdb entered? Actually we want to 
detect errors without pdb hang.
        # We'll run with --pdb and stdin closed (DEVNULL) so pdb quits 
immediately on failure.
        # Instead run with timeout and capture output.
        # For cases without failures, pdb never entered, so fine.
        result = subprocess.run(
            [sys.executable, "-m", "pytest", str(p), "-v", "--pdb"],
            capture_output=True, text=True, input="q\n",
            cwd="/testbed",
        )
        print(f"=== {name} ===")
        print(result.stdout[-2000:])
        print(result.stderr[-500:])
        print(f"returncode={result.returncode}")
        print()
        return result

# 1. skipped method with bad tearDown should be skipped, no error
run_case("skip_method_bad_teardown", textwrap.dedent('''
import unittest
class MyTestCase(unittest.TestCase):
    def setUp(self):
        raise RuntimeError("should not be called")
    @unittest.skip("hello")
    def test_one(self):
        pass
    def tearDown(self):
        raise RuntimeError("tearDown should not be called")
'''))

# 2. normal test tearDown should be called
run_case("normal_teardown_called", textwrap.dedent('''
import unittest, pathlib
class MyTestCase(unittest.TestCase):
    def tearDown(self):
        pathlib.Path("/tmp/normal_teardown_marker").touch()
    def test_1(self):
        pass
    def test_2(self):
        pass
'''))
import pathlib
print("marker exists:", pathlib.Path("/tmp/normal_teardown_marker").exists())
try:
    pathlib.Path("/tmp/normal_teardown_marker").unlink()
except: pass

# 3. setUp failure should NOT call tearDown
run_case("setup_fail_no_teardown", textwrap.dedent('''
import unittest
class MyTestCase(unittest.TestCase):
    def setUp(self):
        raise RuntimeError("setup fail")
    def tearDown(self):
        raise RuntimeError("tearDown should NOT be called when setUp fails")
    def test_1(self):
        pass
'''))

# 4. SkipTest in test method SHOULD call tearDown
run_case("skiptest_in_method_calls_teardown", textwrap.dedent('''
import unittest, pathlib
class MyTestCase(unittest.TestCase):
    def tearDown(self):
        pathlib.Path("/tmp/skiptest_teardown_marker").touch()
    def test_1(self):
        self.skipTest("skip me")
'''))
