    def setup(self):
        # a bound method to be called during teardown() if set (see 'runtest()')
        self._explicit_tearDown = None
        self._testcase = self.parent.obj(self.name)
        self._obj = getattr(self._testcase, self.name)
        if hasattr(self, "_request"):
            self._request._fillfixtures()

    def teardown(self):
        if self._explicit_tearDown is not None and getattr(
            self, "_explicit_tearDown_called", True
        ):
            self._explicit_tearDown()
        self._explicit_tearDown = None
        self._testcase = None
        self._obj = None
            # when entering the pdb prompt, tearDown() would have probably 
cleaned up
            # instance variables, which makes it difficult to debug
            # arguably we could always postpone tearDown(), but this changes the
moment where the
            # TestCase instance interacts with the results object, so better to 
only do it
            # when absolutely needed
            if self.config.getoption("usepdb"):
                self._explicit_tearDown = self._testcase.tearDown
                def _postponed_tearDown(*args, **kwargs):
                    # unittest will call tearDown only if setUp succeeded,
                    # and the test was not skipped via @unittest.skip:
                    # in that case we postpone calling tearDown to the
                    # teardown phase of pytest to allow debugging of
                    # the test instance; otherwise we do not call it at all.
                    # See https://github.com/pytest-dev/pytest/issues/7282.
                    self._explicit_tearDown_called = True
                self._explicit_tearDown_called = False
                setattr(self._testcase, "tearDown", _postponed_tearDown)

            # we need to update the actual bound method with self.obj, because
            # wrap_pytest_function_for_tracing replaces self.obj by a wrapper
            setattr(self._testcase, self.name, self.obj)
            try:
                self._testcase(result=self)
            finally:
                delattr(self._testcase, self.name)

